    "codice": "// Rilevatore di gas: in aria pulita il sensore dà circa 0,4 V (A2 ≈ 80);\n// con il gas la tensione sale. Sopra la soglia si accendono il LED rosso\n// e il buzzer.\n\nconst int SENSORE = A2;\nconst int LED = 10;\nconst int BUZZER = 8;\nconst int SOGLIA = 400;\n\nvoid setup() {\n  pinMode(LED, OUTPUT);\n  Serial.begin(9600);\n  Serial.println(\"Rilevatore di gas pronto\");\n}\n\nvoid loop() {\n  int gas = analogRead(SENSORE);\n  Serial.print(\"Gas:\");\n  Serial.print(gas);\n  Serial.print(\",Soglia:\");\n  Serial.println(SOGLIA);\n  if (gas > SOGLIA) {\n    digitalWrite(LED, HIGH);\n    tone(BUZZER, 1500);\n  } else {\n    digitalWrite(LED, LOW);\n    noTone(BUZZER);\n  }\n  delay(200);\n}\n"
  }
