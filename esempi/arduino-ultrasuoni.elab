    "codice": "// Sensore a ultrasuoni: misura la distanza e accende il LED\n// se un ostacolo è più vicino di 20 cm.\n\nconst int TRIG = 7;\nconst int ECHO = 8;\nconst int LED = 13;\n\nvoid setup() {\n  pinMode(TRIG, OUTPUT);\n  pinMode(ECHO, INPUT);\n  pinMode(LED, OUTPUT);\n  Serial.begin(9600);\n}\n\nvoid loop() {\n  // impulso di 10 microsecondi sul pin TRIG\n  digitalWrite(TRIG, LOW);\n  delayMicroseconds(2);\n  digitalWrite(TRIG, HIGH);\n  delayMicroseconds(10);\n  digitalWrite(TRIG, LOW);\n\n  long durata = pulseIn(ECHO, HIGH);   // microsecondi di andata e ritorno\n  long distanza = durata / 58;         // centimetri\n\n  Serial.print(\"Distanza: \");\n  Serial.print(distanza);\n  Serial.println(\" cm\");\n\n  digitalWrite(LED, distanza < 20);\n  delay(300);\n}\n"
  }
